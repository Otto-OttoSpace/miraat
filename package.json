{
  "name": "miraat",
  "version": "0.6.0",
  "description": "Find & fix the RTL mistakes AI code tools keep making — for Arabic, Hebrew, Syriac, Thaana, N’Ko & Adlam. AST-verified logical CSS, mirrored Tailwind utilities, an MCP server, and an AI-rules file so your agent stops reintroducing them. (formerly rtlint)",
  "bin": {
    "miraat": "bin/miraat.js",
    "miraat-mcp": "mcp/miraat-mcp.js",
    "rtlint": "bin/miraat.js",
    "rtlint-mcp": "mcp/miraat-mcp.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/run.js"
  },
  "keywords": [
    "rtl",
    "rtlint",
    "miraat",
    "arabic",
    "hebrew",
    "syriac",
    "i18n",
    "l10n",
    "tailwind",
    "css-logical-properties",
    "codemod",
    "ai",
    "cursor",
    "claude",
    "bidi"
  ],
  "author": "Othmane Morad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otto-OttoSpace/miraat.git"
  },
  "homepage": "https://github.com/Otto-OttoSpace/miraat#readme",
  "bugs": {
    "url": "https://github.com/Otto-OttoSpace/miraat/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "action.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "postcss": "^8.5.23"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Otto-OttoSpace"
  }
}
