{
  "name": "rtlint",
  "version": "0.3.0",
  "description": "Find & fix the RTL/Arabic mistakes AI code tools keep making — logical CSS, mirrored Tailwind utilities, an MCP server, and an AI-rules file so your agent stops reintroducing them.",
  "bin": {
    "rtlint": "bin/rtlint.js",
    "rtlint-mcp": "mcp/rtlint-mcp.js"
  },
  "type": "commonjs",
  "keywords": [
    "rtl",
    "arabic",
    "i18n",
    "l10n",
    "tailwind",
    "css-logical-properties",
    "codemod",
    "ai",
    "cursor",
    "claude",
    "bidi"
  ],
  "author": "Othmane Morad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moradothmanepro-OTTO/rtlint.git"
  },
  "homepage": "https://github.com/moradothmanepro-OTTO/rtlint#readme",
  "bugs": {
    "url": "https://github.com/moradothmanepro-OTTO/rtlint/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin",
    "mcp",
    "action.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
